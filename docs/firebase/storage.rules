rules_version = '2';

// =====================================================================
//  한국심사자격인증원 — 자격인증 신청 증빙서류 보안 규칙 (Firebase Storage)
//  · 로그인 없이 "새 파일 올리기"만 허용 (파일당 30MB 이하, 허용 형식만)
//  · 목록 조회 · 덮어쓰기 · 삭제는 모두 금지
//  · 파일은 담당자 메일의 다운로드 링크(고유 토큰)로만 내려받음
//  ※ 'allow read, write: if true;' 는 누구나 전체 목록을 보고 내려받거나
//     지울 수 있어 신청인 개인정보가 유출될 수 있으므로 사용하지 않습니다.
// =====================================================================
service firebase.storage {
  match /b/{bucket}/o {

    // 홈페이지가 올리는 위치 : applications/날짜/접수번호_무작위문자/파일
    match /applications/{day}/{appId}/{fileName} {

      // 새 파일 올리기 (로그인 불필요)
      allow create: if request.resource.size > 0
                    && request.resource.size <= 30 * 1024 * 1024
                    && fileName.matches('(?i).+[.](pdf|hwp|docx|xlsx|jpg)')
                    && request.resource.contentType.matches(
                         'application/pdf|application/x-hwp|image/jpeg|' +
                         'application/vnd[.]openxmlformats-officedocument[.]wordprocessingml[.]document|' +
                         'application/vnd[.]openxmlformats-officedocument[.]spreadsheetml[.]sheet');

      // 다운로드 링크 만들기용 파일 정보 조회 (폴더 이름이 무작위라 주소 추측 불가)
      allow get: if true;

      // 목록 보기 · 덮어쓰기 · 삭제 금지
      allow list, update, delete: if false;
    }

    // 그 밖의 모든 위치는 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
